{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japan-voice-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_REALTIME_MODEL": "gpt-realtime-1.5"
  }
  // Set APP_SHARED_SECRET and OPENAI_API_KEY with `wrangler secret put`.
}
